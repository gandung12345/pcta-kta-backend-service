<?xml version="1.0"?>
<ruleset name="Schnell coding standard">
    <description>Schnell coding standard</description>

    <!-- display progress -->
    <arg value="p"/>
    <!-- use colors in output -->
    <arg name="colors"/>

    <!-- inherit rules from: -->
    <rule ref="PSR12"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Paths to check -->
    <file>public</file>
    <file>app</file>
    <file>functions</file>
    <file>src</file>
    <file>tests</file>

    <!-- exclude assets directory -->
    <exclude-pattern>public/templates/*</exclude-pattern>
</ruleset>
