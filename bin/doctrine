#! /usr/bin/env php

<?php

/**
 * @author Paulus Gandung Prakosa <gandung@infradead.org>
 */

require __DIR__ . DIRECTORY_SEPARATOR . '../vendor/autoload.php';

use Doctrine\ORM\Tools\Console\ConsoleRunner;
use Doctrine\ORM\Tools\Console\EntityManagerProvider\SingleManagerProvider;
use Schnell\Bridge\Cache\CacheBridge;
use Schnell\Bridge\Doctrine\DoctrineBridge;
use Schnell\Config\ConfigFactory;
use Schnell\Container;

// help opcache.preload discover always-needed symbols
// phpcs:disable
class_exists(ConsoleRunner::class);
class_exists(SingleManagerProvider::class);
class_exists(CacheBridge::class);
class_exists(DoctrineBridge::class);
class_exists(ConfigFactory::class);
class_exists(Container::class);
// phpcs:enable

$configFactory = new ConfigFactory();
$configFactory->importBulk([
    '../config/app.conf',
    '../config/database.conf',
    '../config/bridge/cache.conf',
    '../config/bridge/doctrine.conf'
]);

$config = $configFactory->getConfig();
$container = new Container($config);

$cacheBridge = new CacheBridge($config, $container);
$cacheBridge->setBasePath(getcwd() . DIRECTORY_SEPARATOR . '..');
$cacheBridge->load();

$bridge = new DoctrineBridge($config, $container);
$bridge->setBasePath(getcwd() . DIRECTORY_SEPARATOR . '..');
$bridge->load();

ConsoleRunner::run(
    new SingleManagerProvider($container->get('entity-manager'))
);
